#!/usr/bin/env pwsh
# 用途：样例应用（#55）：一次性只读抓取，走 browse fetch（HTTP 优先三条件升级）
# 契约：本机进程，子命令路由，经 CLI/HTTP 面驱动 daemon；崩溃只死自己
param(
    [Parameter(Position=0, Mandatory=$true)][string]$Url,
    [switch]$Markdown
)
$ErrorActionPreference = 'Stop'
$browse = Get-Command browse -ErrorAction Stop
$args_ = @('fetch', $Url, '--timeout', '20')
if ($Markdown) { $args_ += '--markdown' }
& $browse.Source @args_
exit $LASTEXITCODE
